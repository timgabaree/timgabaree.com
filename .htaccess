# ----------------------------------------------------------------------
# Canonical Redirects and Extensionless PHP URLs
# ----------------------------------------------------------------------

Options -MultiViews

<IfModule mod_rewrite.c>

  RewriteEngine On

  # --------------------------------------------------
  # Exclude Hosted Child Domains
  # --------------------------------------------------
  #
  # The RGE document root also contains other hosted domains.
  # Stop RGE-specific rewrite processing when the request host
  # is not timgabaree.com or www.timgabaree.com.
  #

  RewriteCond %{HTTP_HOST} !^(?:www\.)?timgabaree\.com$ [NC]
  RewriteRule ^ - [L]

  # --------------------------------------------------
  # Preserve Custom Error Handlers
  # --------------------------------------------------

  RewriteRule ^errors/(403|404|500)\.php$ - [END]

  # --------------------------------------------------
  # Branded 403 for Protected Application Files
  # --------------------------------------------------

  RewriteCond %{THE_REQUEST} \s/+includes(?:/|%2F) [NC]
  RewriteRule ^includes(?:/.*)?$ /errors/403.php [END]

  # --------------------------------------------------
  # Force HTTPS and Non-WWW
  # --------------------------------------------------

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.timgabaree\.com$ [NC]
  RewriteRule ^ https://timgabaree.com%{REQUEST_URI} [R=301,L,NE]

  # --------------------------------------------------
  # Legacy HTML URLs
  # --------------------------------------------------

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

  # --------------------------------------------------
  # Remove Public PHP Extensions
  # --------------------------------------------------

  RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]) [NC]
  RewriteRule ^index\.php$ / [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
  RewriteCond %{REQUEST_URI} !^/errors/(403|404|500)\.php$ [NC]
  RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

  # --------------------------------------------------
  # Internally Resolve Extensionless PHP URLs
  # --------------------------------------------------

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # --------------------------------------------------
  # Branded 404 Catch-All
  # --------------------------------------------------

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ errors/404.php [L]

</IfModule>

# ----------------------------------------------------------------------
# Custom Error Documents
# ----------------------------------------------------------------------

ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php